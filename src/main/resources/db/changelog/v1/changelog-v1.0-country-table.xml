<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-country-table" author="sarkan">

        <createTable tableName="country">
            <column name="id" type="NUMBER">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="code" type="VARCHAR2(3)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="name_en" type="VARCHAR2(100)">
                <constraints nullable="false"/>
            </column>

            <column name="name_az" type="VARCHAR2(100)">
                <constraints nullable="false"/>
            </column>

            <column name="name_ru" type="VARCHAR2(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Add identity/autoincrement support for Oracle -->
        <addAutoIncrement
            tableName="country"
            columnName="id"
            columnDataType="NUMBER"/>

    </changeSet>
</databaseChangeLog>
