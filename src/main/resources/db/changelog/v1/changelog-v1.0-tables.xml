<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Create Organization table -->
    <changeSet id="02-07-2024-create_organization_table" author="Samadov Nijat">
        <createTable tableName="organizations">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(50)"/>
            <column name="type" type="organization_type"/>
            <column name="description" type="varchar(255)"/>
            <column name="phone_number" type="varchar(50)"/>
            <column name="num_employees" type="int"/>
            <column name="country" type="varchar(50)"/>
            <column name="industry" type="varchar(50)"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
    </changeSet>

    <changeSet id="11-07-2024-create_roles_table" author="Samadov Nijat">
        <createTable tableName="roles">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role" type="role_type"/>
        </createTable>
    </changeSet>

    <!-- Create User table -->
    <changeSet id="02-07-2024-create_user_table" author="Samadov Nijat">
        <createTable tableName="users">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="char(32)"/>
            <column name="first_name" type="varchar(50)"/>
            <column name="last_name" type="varchar(50)"/>
            <column name="email" type="varchar(50)"/>
            <column name="password" type="varchar(255)"/>
            <column name="profile_picture_key" type="varchar(100)"/>
            <column name="is_active" type="boolean"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="users"
                                 baseColumnNames="organization_id"
                                 constraintName="fk_user_organization"
                                 referencedTableName="organizations"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="11-07-2024-create_user_roles_table" author="Samadov Nijat">
        <createTable tableName="user_roles">
            <column name="role_id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!-- Create Course table -->
    <changeSet id="02-07-2024-create_course_table" author="Samadov Nijat">
        <createTable tableName="courses">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)"/>
            <column name="tags" type="varchar(255)"/>
            <column name="picture_key" type="varchar(255)"/>
            <column name="organization_id" type="char(32)"/>
            <column name="title" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="instructor" type="VARCHAR(255)"/>
            <column name="duration" type="VARCHAR(50)"/>
            <column name="is_deleted" type="boolean"/>
            <column name="is_visible" type="boolean"/>
            <column name="available_point" type="int"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="courses"
                                 baseColumnNames="organization_id"
                                 constraintName="fk_course_organization"
                                 referencedTableName="organizations"
                                 referencedColumnNames="id"/>
    </changeSet>

    <!-- Create Part table -->
    <changeSet id="02-07-2024-create_part_table" author="Samadov Nijat">
        <createTable tableName="lectures">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="video_key" type="VARCHAR(255)"/>
            <column name="duration" type="VARCHAR(50)"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
    </changeSet>

    <!-- Create Quiz table -->
    <changeSet id="02-07-2024-create_quiz_table" author="Samadov Nijat">
        <createTable tableName="quizzes">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="number_of_questions" type="INT"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
    </changeSet>

    <!-- Create CourseContent table -->
    <changeSet id="02-07-2024-create_course_content_table" author="Samadov Nijat">
        <createTable tableName="course_contents">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="course_id" type="char(32)"/>
            <column name="lecture_id" type="char(32)"/>
            <column name="quiz_id" type="char(32)"/>
            <column name="type" type="content_type"/>
            <column name="sequence_number" type="int"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>

        </createTable>
        <addForeignKeyConstraint baseColumnNames="course_id"
                                 baseTableName="course_contents"
                                 constraintName="fk_CourseContent_Courses"
                                 referencedColumnNames="id"
                                 referencedTableName="courses"/>
        <addForeignKeyConstraint baseTableName="course_contents"
                                 baseColumnNames="lecture_id"
                                 constraintName="fk_course_content_lectures"
                                 referencedTableName="lectures"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="course_contents"
                                 baseColumnNames="quiz_id"
                                 constraintName="fk_course_content_quiz"
                                 referencedTableName="quizzes"
                                 referencedColumnNames="id"/>
    </changeSet>

    <!-- Create Progress table -->
    <changeSet id="02-07-2024-create_progress_table" author="Samadov Nijat">
        <createTable tableName="progress">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="char(32)"/>
            <column name="course_id" type="char(32)"/>
            <column name="content_id" type="char(32)"/>
            <column name="is_completed" type="boolean"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="progress"
                                 baseColumnNames="user_id"
                                 constraintName="fk_progress_user"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="progress"
                                 baseColumnNames="course_id"
                                 constraintName="fk_progress_courses"
                                 referencedTableName="courses"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="progress"
                                 baseColumnNames="content_id"
                                 constraintName="fk_progress_contents"
                                 referencedTableName="course_contents"
                                 referencedColumnNames="id"/>
    </changeSet>

    <!-- Create Completion table -->
    <changeSet id="02-07-2024-create_completion_table" author="Samadov Nijat">
        <createTable tableName="completions">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="char(32)"/>
            <column name="course_id" type="char(32)"/>
            <column name="completion_date" type="DATE"/>
            <column name="is_deleted" type="boolean"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="completions"
                                 baseColumnNames="user_id"
                                 constraintName="fk_completion_user"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="completions"
                                 baseColumnNames="course_id"
                                 constraintName="fk_completion_courses"
                                 referencedTableName="courses"
                                 referencedColumnNames="id"/>
    </changeSet>


    <!-- Create CourseAssignment table -->
    <changeSet id="02-07-2024-create_course_assignment_table" author="Samadov Nijat">
        <createTable tableName="course_assignments">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="course_id" type="char(32)"/>
            <column name="organization_id" type="char(32)"/>
            <column name="assigned_date" type="timestamp without timezone"/>
            <column name="confirmed" type="BOOLEAN"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="course_assignments"
                                 baseColumnNames="course_id"
                                 constraintName="fk_course_assignment_courses"
                                 referencedTableName="courses"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="course_assignments"
                                 baseColumnNames="organization_id"
                                 constraintName="fk_course_assignment_organizations"
                                 referencedTableName="organizations"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="04-07-2024-create_quiz_section_table" author="Samadov Nijat">
        <createTable tableName="quiz_sections">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quiz_id" type="char(32)"/>
            <column name="title" type="varchar(50)"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="quiz_sections"
                                 baseColumnNames="quiz_id"
                                 constraintName="fk_quiz_section_quizzes"
                                 referencedTableName="quizzes"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="04-07-2024-create_question_table" author="Samadov Nijat">
        <createTable tableName="questions">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quiz_section_id" type="char(32)"/>
            <column name="text" type="varchar(255)"/>
            <column name="selection_type" type="selection_type"/>
            <column name="question_option" type="text"/>
            <column name="correct_option" type="text"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="questions"
                                 baseColumnNames="quiz_section_id"
                                 constraintName="fk_question_quiz_sections"
                                 referencedTableName="quiz_sections"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="07-07-2024-create_course_detail_table" author="Samadov Nijat">
        <createTable tableName="course_details">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="course_id" type="char(32)"/>
            <column name="name" type="varchar(100)"/>
            <column name="sections" type="int"/>
            <column name="author" type="varchar(50)"/>
            <column name="published_date" type="timestamp without timezone"/>
            <column name="available_points" type="int"/>
            <column name="categories" type="text"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="course_details"
                                 baseColumnNames="course_id"
                                 constraintName="fk_course_details_course"
                                 referencedTableName="courses"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="28-07-2024-add_domain_column_to_organizations_table" author="Samadov Nijat">
        <addColumn tableName="organizations">
            <column name="domain" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="28-07-2024-add_is_deleted_column_to_organizations_table" author="Samadov Nijat">
        <addColumn tableName="organizations">
            <column name="is_deleted" type="boolean"/>
        </addColumn>
    </changeSet>

    <changeSet id="15-08-2024-create_registration_verification_session_table" author="Samadov Nijat">
        <createTable tableName="registration_verification_sessions">
            <column name="id" type="char(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="char(32)"/>
            <column name="verification_id" type="char(32)"/>
            <column name="is_verified" type="boolean"/>
            <column name="is_deleted" type="boolean"/>
            <column name="create_date" type="timestamp without timezone"/>
            <column name="update_date" type="timestamp without timezone"/>
        </createTable>
    </changeSet>

    <changeSet id="22-08-2024-add_logo_key_name_column_to_organizations" author="Samadov Nijat">
        <addColumn tableName="organizations">
            <column name="logo_key_name" type="varchar(255)"/>
        </addColumn>
    </changeSet>


</databaseChangeLog>